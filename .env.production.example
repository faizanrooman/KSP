# =====================================================================================================================
# KSP Video Evidence Management System — PRODUCTION environment reference
# =====================================================================================================================
# Every variable read by packages/core/src/config.ts (api, worker, ai-worker, migrate) plus the few read directly by a
# service. Kubernetes: non-secret values go into the ksp-config / ksp-ai-config ConfigMaps (deploy/k8s/base/config.yaml),
# [SECRET] values come from the secrets manager (docs/SECRETS.md). Compose: deploy/compose/.env.example.
#
# The services run the PRODUCTION PREFLIGHT at startup (packages/core/src/preflight.ts, docs/GO-LIVE-CHECKLIST.md) and
# refuse to start (exit code 78) on any violation. Check a configuration before deploying:
#     npm run preflight                  # all services, with database checks; exit 1 on any violation
#     npm run preflight -- --service api --json
# Values below marked (preflight) are enforced. Never commit a filled copy of this file.
# =====================================================================================================================

# --- tier & preflight -------------------------------------------------------------------------------------------------
NODE_ENV=production                              # (preflight) must be production
KSP_ENVIRONMENT=production                       # production | staging | demo. Default with NODE_ENV=production: production
# KSP_PREFLIGHT=enforce                          # enforce (default) | warn | off — warn/off are REFUSED when KSP_ENVIRONMENT=production
#                                                  (demo clusters such as minikube: KSP_ENVIRONMENT=demo KSP_PREFLIGHT=warn)
LOG_LEVEL=info                                   # fatal|error|warn|info|debug|trace|silent (debug/trace: preflight warning)

# --- HTTP / browser ---------------------------------------------------------------------------------------------------
APP_BASE_URL=https://vms.ksp.gov.in              # (preflight) https only; used in links and e-mails
CORS_ORIGINS=https://vms.ksp.gov.in              # (preflight) comma-separated https origins of the SPA, no '*'
COOKIE_SECURE=true                               # (preflight + config loader) must be true
TRUST_PROXY=true                                 # true behind the ingress (client IPs in the audit trail); false = warning
API_HOST=0.0.0.0
API_PORT=4000
METRICS_HOST=0.0.0.0                             # internal Prometheus endpoint; never exposed through the ingress
METRICS_PORT=9464                                # api :9464, worker :9465, ai-worker :9466
RATE_LIMIT_STORE=postgres                        # (preflight) postgres (default in production) | memory (refused with >1 replica)
KSP_EXPECTED_API_REPLICAS=3                      # declared replica count for the rate-limit rule (unset = assumed > 1)

# --- PostgreSQL -------------------------------------------------------------------------------------------------------
# (preflight) connect as ksp_app (never the schema owner / a superuser) with TLS; strong generated passwords.
DATABASE_URL=postgres://ksp_app:[SECRET]@ksp-db-rw.ksp-vms.svc:5432/ksp?sslmode=verify-full
DATABASE_MIGRATION_URL=postgres://ksp_owner:[SECRET]@ksp-db-rw.ksp-vms.svc:5432/ksp?sslmode=verify-full   # migrate Job only
DATABASE_AI_URL=postgres://ksp_ai:[SECRET]@ksp-db-rw.ksp-vms.svc:5432/ksp?sslmode=verify-full             # ai-worker only
DATABASE_POOL_MAX=20
# PGSSLROOTCERT=/run/secrets/ksp/db-ca.crt       # CA of the database server certificate (libpq/pg standard variable)
# DATABASE_TLS_WAIVED=false                      # true only for a Unix socket / same-pod proxy (preflight warning)

# --- Object storage (S3 API) ------------------------------------------------------------------------------------------
S3_ENDPOINT=https://s3.storage.ksp.internal      # http:// = preflight warning (acceptable only inside a trusted network)
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=[SECRET]                           # (preflight) application identity (deploy/s3/policies/app.json); no dev values
S3_SECRET_KEY=[SECRET]
S3_AI_ACCESS_KEY=[SECRET]                        # (preflight, ai-worker) SEPARATE identity: derived bucket only (ai.json)
S3_AI_SECRET_KEY=[SECRET]
S3_BUCKET_STAGING=ksp-staging
S3_BUCKET_EVIDENCE=ksp-evidence
S3_BUCKET_ARCHIVE=ksp-evidence-archive
S3_BUCKET_LONG_TERM=ksp-evidence-longterm
S3_BUCKET_DERIVED=ksp-derived
S3_BUCKET_EXPORTS=ksp-exports
S3_BUCKET_REPORTS=ksp-reports
OBJECT_LOCK_MODE=COMPLIANCE                      # (preflight) COMPLIANCE; GOVERNANCE only with the flag below; NONE refused
OBJECT_LOCK_DAYS=3650                            # default retention applied to every original
# OBJECT_LOCK_MODE_ACCEPT_GOVERNANCE=false       # custodian decision EXT-8 recorded -> GOVERNANCE allowed (preflight warning)

# --- Tokens & keys ----------------------------------------------------------------------------------------------------
JWT_PRIVATE_KEY=file:/run/secrets/ksp/jwt_private_key     # Ed25519 PEM (inline with \n escapes, or file:)
JWT_PUBLIC_KEY=file:/run/secrets/ksp/jwt_public_key
JWT_ISSUER=ksp-vms
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_HOURS=12
DATA_ENCRYPTION_KEYS=k2026a:[SECRET-32-bytes-base64]      # (preflight) keyring, first = current; or DATA_ENCRYPTION_KEY
MEDIA_TOKEN_SECRET=[SECRET-64-hex]                        # (preflight) >= 32 chars, random
MEDIA_TOKEN_TTL_SECONDS=300

# --- Evidence signing (export manifests, custody reports, audit checkpoints) — docs/SECRETS.md#hsm ------------------------
# (preflight) the dev self-signed "NOT FOR COURT USE" certificate, any self-signed certificate and the key id
# ksp-dev-signing-key are REFUSED. Staging only: KSP_ALLOW_NONEVIDENTIARY_SIGNING=true (PDFs stamped NON-EVIDENTIARY).
SIGNING_PROVIDER=pkcs11                          # pkcs11 (HSM / token) | pem (key file; preflight warning)
SIGNING_KEY_ID=ksp-evidence-signing-2026         # new id for every new key/certificate
PKCS11_MODULE=/usr/lib/vendor/libcryptoki.so     # vendor PKCS#11 library mounted into api + worker
PKCS11_TOKEN_LABEL=ksp-evidence                  # or PKCS11_SLOT=<index|id>
PKCS11_PIN_FILE=/run/secrets/ksp/pkcs11_pin      # [SECRET] user PIN in a mounted file (never inline)
PKCS11_KEY_LABEL=ksp-evidence-signing-2026       # CKA_LABEL of the private key (and of the certificate object if on the token)
# PKCS11_KEY_ID=01                               # CKA_ID (hex) when labels are not unique
# PKCS11_CERTIFICATE=file:/run/secrets/ksp/signing_certificate   # when the CA-issued certificate is not on the token
# PKCS11_RSA_SCHEME=pkcs1                        # RSA keys: pkcs1 (RSA-SHA256, default) | pss (RSA-PSS-SHA256)
# SIGNING_PRIVATE_KEY=file:/run/secrets/ksp/signing_private_key  # SIGNING_PROVIDER=pem only
# SIGNING_CERTIFICATE=file:/run/secrets/ksp/signing_certificate  # SIGNING_PROVIDER=pem only
# KSP_ALLOW_NONEVIDENTIARY_SIGNING=false         # staging/demo only; refused on KSP_ENVIRONMENT=production

# --- AI (legal gates EXT-4 / EXT-5) ---------------------------------------------------------------------------------------
AI_TASKS_ENABLED=OBJECT_DETECTION,PERSON_DETECTION,CLASSIFICATION   # production default; add FACE_DETECTION,
#                                                  FACE_RECOGNITION,ANPR only after the legal approval is ALSO recorded in
#                                                  Settings → Legal approvals (both are required)
# AI_LEGAL_GATES=enforce                         # (preflight) enforce is the production default; off is refused
AI_MODELS_DIR=/models
AI_WORKER_CONCURRENCY=1                          # ai-worker: parallel jobs per pod
AI_INTRA_OP_THREADS=4                            # ai-worker: ONNX Runtime threads per job

# --- Media pipeline (EXT-9, docs/VIDEO-PIPELINE.md#profiles, capacity: docs/INFRASTRUCTURE.md) --------------------------
MEDIA_PROFILE=on-demand-hls                      # full | proxy-only | on-demand-hls (capacity decision; default full)
MEDIA_ENCODER=libx264                            # libx264 | h264_nvenc | h264_qsv | h264_vaapi (auto-fallback to libx264)
MEDIA_HW_DEVICE=/dev/dri/renderD128              # VA-API / QSV render node
WORKER_CONCURRENCY=2                             # concurrent media jobs per worker pod
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe
WORK_DIR=/work
SNAPSHOT_WAIT_SECONDS=20                         # api: synchronous wait for a still-frame extraction

# --- Integrations -----------------------------------------------------------------------------------------------------
# (preflight) integration systems with the synthetic 'fixture' adapter must not be enabled.
# INTEGRATION_EGRESS_ALLOW=cctns.ksp.gov.in      # private/reserved destinations allowed for http-json adapters
# KSP_SECRET_CCTNS=[SECRET]                      # credentials_ref=CCTNS: bearer token or user:password
# KSP_SECRET_CCTNS_CERT=/run/secrets/ksp/cctns-client.crt   # mTLS client certificate / key / CA (PEM file paths)
# KSP_SECRET_CCTNS_KEY=/run/secrets/ksp/cctns-client.key
# KSP_SECRET_CCTNS_CA=/run/secrets/ksp/cctns-ca.crt

# --- Alert delivery (optional) ----------------------------------------------------------------------------------------
# ALERT_SMTP_URL=smtps://alerts%40ksp.gov.in:[SECRET]@smtp.ksp.gov.in:465
# ALERT_WEBHOOK_URL=https://noc.ksp.internal/hooks/ksp-vms

# --- Isolated AI worker ConfigMap only ----------------------------------------------------------------------------------
# KSP_SERVICE=ksp-ai-worker                      # the ai-worker needs NO JWT / signing / media-token / data keys (OPS-9)
