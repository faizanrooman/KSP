{
  "name": "@ksp/ai-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=ksp-src src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fetch-models": "tsx --conditions=ksp-src scripts/fetch-models.ts",
    "evaluate": "tsx --conditions=ksp-src scripts/evaluate-model.ts"
  },
  "dependencies": {
    "@ksp/core": "^1.0.0",
    "@ksp/shared": "^1.0.0",
    "jpeg-js": "^0.4.4",
    "kysely": "^0.29.6",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
