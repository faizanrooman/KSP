{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrimaryReadOnly_attach_on_PRIMARY_store",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectRetention", "s3:GetObjectLegalHold", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::ksp-evidence", "arn:aws:s3:::ksp-evidence/*", "arn:aws:s3:::ksp-evidence-archive", "arn:aws:s3:::ksp-evidence-archive/*",
        "arn:aws:s3:::ksp-evidence-longterm", "arn:aws:s3:::ksp-evidence-longterm/*", "arn:aws:s3:::ksp-derived", "arn:aws:s3:::ksp-derived/*",
        "arn:aws:s3:::ksp-exports", "arn:aws:s3:::ksp-exports/*", "arn:aws:s3:::ksp-reports", "arn:aws:s3:::ksp-reports/*"
      ]
    },
    {
      "Sid": "DrWriteNoDelete_attach_on_DR_store",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:PutObjectLegalHold", "s3:GetObject", "s3:ListBucket", "s3:CreateBucket", "s3:PutBucketVersioning", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::ksp-*", "arn:aws:s3:::ksp-*/*"]
    },
    {
      "Sid": "NeverDelete",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention", "s3:DeleteBucket"],
      "Resource": "*"
    }
  ]
}
