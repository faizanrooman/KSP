{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KspAppObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObjectRetention",
        "s3:PutObjectRetention",
        "s3:GetObjectLegalHold",
        "s3:PutObjectLegalHold",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::ksp-staging/*",
        "arn:aws:s3:::ksp-evidence/*",
        "arn:aws:s3:::ksp-evidence-archive/*",
        "arn:aws:s3:::ksp-evidence-longterm/*",
        "arn:aws:s3:::ksp-derived/*",
        "arn:aws:s3:::ksp-exports/*",
        "arn:aws:s3:::ksp-reports/*"
      ]
    },
    {
      "Sid": "KspAppBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::ksp-staging",
        "arn:aws:s3:::ksp-evidence",
        "arn:aws:s3:::ksp-evidence-archive",
        "arn:aws:s3:::ksp-evidence-longterm",
        "arn:aws:s3:::ksp-derived",
        "arn:aws:s3:::ksp-exports",
        "arn:aws:s3:::ksp-reports"
      ]
    },
    {
      "Sid": "NoPolicyOrLockChanges",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketVersioning",
        "s3:DeleteBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoLockOverrideOnEvidence",
      "Effect": "Deny",
      "Action": [
        "s3:BypassGovernanceRetention",
        "s3:DeleteObjectVersion",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::ksp-evidence/*",
        "arn:aws:s3:::ksp-evidence-archive/*",
        "arn:aws:s3:::ksp-evidence-longterm/*"
      ]
    }
  ]
}
