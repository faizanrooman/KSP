{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KspProvisionBucketsMigrateJobOnly",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:PutBucketObjectLockConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::ksp-staging",
        "arn:aws:s3:::ksp-evidence",
        "arn:aws:s3:::ksp-evidence-archive",
        "arn:aws:s3:::ksp-evidence-longterm",
        "arn:aws:s3:::ksp-derived",
        "arn:aws:s3:::ksp-exports",
        "arn:aws:s3:::ksp-reports"
      ]
    },
    {
      "Sid": "NoObjectAccessNoDeletes",
      "Effect": "Deny",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention", "s3:DeleteBucket", "s3:PutBucketPolicy"],
      "Resource": "*"
    }
  ]
}
