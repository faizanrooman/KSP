{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KspBackupWriteAndRead",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:GetObject", "s3:GetObjectRetention", "s3:ListBucket", "s3:ListBucketVersions", "s3:DeleteObjectVersion", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::ksp-db-backups", "arn:aws:s3:::ksp-db-backups/*"]
    },
    {
      "Sid": "BackupsCannotBeShortened",
      "Effect": "Deny",
      "Action": ["s3:BypassGovernanceRetention", "s3:PutBucketObjectLockConfiguration", "s3:PutBucketVersioning", "s3:DeleteBucket", "s3:PutBucketPolicy"],
      "Resource": "*"
    }
  ]
}
