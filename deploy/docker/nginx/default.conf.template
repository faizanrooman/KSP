# KSP VMS web tier (nginx-unprivileged, port 8080). Rendered by the image's envsubst entrypoint into
# /etc/nginx/conf.d (mount an emptyDir there when the root FS is read-only). Only variables matching
# NGINX_ENVSUBST_FILTER (API_UPSTREAM*) are substituted. TLS terminates at the ingress / load balancer.
server_tokens off;

upstream ksp_api {
  server ${API_UPSTREAM_HOSTPORT};
  keepalive 32;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  charset utf-8;

  # Chunked evidence uploads send up to 128 MiB per chunk (API limit); allow a little framing overhead.
  client_max_body_size 130m;
  client_body_buffer_size 1m;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  location /api/ {
    proxy_pass http://ksp_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_request_buffering off;   # stream upload chunks straight to the API
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    # API responses carry their own security headers (helmet); do not duplicate them here.
  }

  # Media streaming (Range requests, HLS segments, original downloads): no buffering, long timeouts.
  location /api/v1/media/ {
    proxy_pass http://ksp_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Never serve source maps publicly.
  location ~ \.map$ { return 404; }

  # Hashed build assets: immutable, long cache.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA fallback: unknown paths render index.html (client-side routing). index.html itself is never cached.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    try_files $uri $uri/ /index.html;
  }
}
