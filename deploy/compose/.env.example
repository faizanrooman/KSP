# KSP VMS — compose environment. Copy to deploy/compose/.env (git-ignored) and fill in.
# [SECRET] = generate with scripts/ops/generate-secrets.sh (it writes secrets.env with these keys) and keep it
# in the secrets manager; never commit. Every variable of packages/core/src/config.ts is listed (see docs/SECRETS.md).

# --- images -------------------------------------------------------------------------------------------------
KSP_IMAGE_REGISTRY=ghcr.io/ksp
KSP_VERSION=1.0.0

# --- application (config.ts) ----------------------------------------------------------------------------------
# NODE_ENV is fixed to production by compose; COOKIE_SECURE=true and TRUST_PROXY=true are enforced there too.
LOG_LEVEL=info                                  # fatal|error|warn|info|debug|trace|silent
APP_BASE_URL=https://vms.ksp.example            # public URL users open (used in links/e-mails)
CORS_ORIGINS=https://vms.ksp.example            # comma-separated; the SPA is same-origin behind the web tier
# API_PORT / API_HOST / METRICS_PORT / METRICS_HOST / WORK_DIR / FFMPEG_PATH / FFPROBE_PATH / AI_MODELS_DIR are
# fixed by the images (4000 / 0.0.0.0 / 9464 / 0.0.0.0 / /work / /usr/local/bin/ffmpeg / ffprobe / /models).
DATABASE_POOL_MAX=20
WORKER_CONCURRENCY=2                            # concurrent media jobs per worker container
AI_WORKER_CONCURRENCY=1
API_REPLICAS=2

# --- PostgreSQL -----------------------------------------------------------------------------------------------
POSTGRES_DB=ksp
PG_SHARED_BUFFERS=1GB
PG_MAX_CONNECTIONS=200
KSP_OWNER_DB_PASSWORD=                          # [SECRET] schema owner, migrate job only (DATABASE_MIGRATION_URL)
KSP_APP_DB_PASSWORD=                            # [SECRET] ksp_app: api + worker (DATABASE_URL)
KSP_AI_DB_PASSWORD=                             # [SECRET] ksp_ai: ai-worker only (DATABASE_AI_URL)
KSP_BACKUP_DB_PASSWORD=                         # [SECRET] ksp_backup (pg_read_all_data): backup jobs only
# Also as files in deploy/compose/secrets/: pg_superuser_password, ksp_*_db_password (same values as above)

# --- object storage -------------------------------------------------------------------------------------------
S3_ENDPOINT=http://s3:7070                      # bundled versitygw; or https://minio.internal / AWS regional endpoint
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ROOT_ACCESS_KEY=                             # [SECRET] bundled gateway root identity (admin only)
S3_ROOT_SECRET_KEY=                             # [SECRET]
S3_ACCESS_KEY=                                  # [SECRET] application identity (all app buckets)
S3_SECRET_KEY=                                  # [SECRET]
S3_AI_ACCESS_KEY=                               # [SECRET] AI identity: derived bucket ONLY (deploy/s3/policies/ai.json)
S3_AI_SECRET_KEY=                               # [SECRET]
S3_BUCKET_STAGING=ksp-staging
S3_BUCKET_EVIDENCE=ksp-evidence
S3_BUCKET_ARCHIVE=ksp-evidence-archive
S3_BUCKET_LONG_TERM=ksp-evidence-longterm
S3_BUCKET_DERIVED=ksp-derived
S3_BUCKET_EXPORTS=ksp-exports
S3_BUCKET_REPORTS=ksp-reports
OBJECT_LOCK_MODE=GOVERNANCE                     # GOVERNANCE|COMPLIANCE (NONE is rejected in production)
OBJECT_LOCK_DAYS=3650                           # default retention applied to every original

# --- keys & tokens (config.ts) --------------------------------------------------------------------------------
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY / SIGNING_PRIVATE_KEY / SIGNING_CERTIFICATE are mounted as Docker secrets and
# referenced as file:/run/secrets/<name> by compose (config.ts supports the file: prefix).
JWT_ISSUER=ksp-vms
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_HOURS=12
DATA_ENCRYPTION_KEY=                            # [SECRET] 32 bytes base64 (AES-256-GCM for MFA secrets at rest)
MEDIA_TOKEN_SECRET=                             # [SECRET] >= 32 chars (HMAC for media tokens)
MEDIA_TOKEN_TTL_SECONDS=300
SIGNING_KEY_ID=ksp-evidence-signing-2026        # identifier of the signing key/cert pair (rotate -> new id)

# --- backups (scripts/backup) ---------------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=https://backup-s3.dr.ksp.example   # SEPARATE store/site from primary storage
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=ksp-db-backups                 # versioned + Object Lock bucket
BACKUP_S3_ACCESS_KEY=                           # [SECRET] write-only-ish backup identity (deploy/s3/policies/backup.json)
BACKUP_S3_SECRET_KEY=                           # [SECRET]
BACKUP_RETENTION_DAYS=35
# The backup encryption PUBLIC key(s) go in secrets/backup_age_recipients. The age PRIVATE key is kept OFFLINE
# (sealed envelope / HSM-backed vault) and is only needed to restore.

# --- web / monitoring -----------------------------------------------------------------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=8080
GRAFANA_PORT=3000
