{
  "name": "@ksp/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ksp-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev-seed": {
      "ksp-src": "./src/dev/seed.ts",
      "types": "./dist/dev/seed.d.ts",
      "import": "./dist/dev/seed.js"
    },
    "./custody": {
      "ksp-src": "./src/custody/index.ts",
      "types": "./dist/custody/index.d.ts",
      "import": "./dist/custody/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --conditions=ksp-src src/bin/migrate.ts",
    "migrate:test": "NODE_ENV=test tsx src/bin/migrate.ts",
    "seed": "KSP_SEED_CLI=1 tsx --conditions=ksp-src src/bin/seed.ts",
    "codegen": "tsx --conditions=ksp-src src/bin/codegen.ts",
    "test": "NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/lib-storage": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@ksp/shared": "*",
    "@node-rs/argon2": "^2.2.1",
    "cron-parser": "^5.10.1",
    "dotenv": "^18.0.3",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3"
  }
}
