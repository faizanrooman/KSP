{
  "name": "@ksp/station-client",
  "version": "1.0.0",
  "private": true,
  "description": "KSP police-station bulk evidence upload client (resumable, chunked, concurrent)",
  "type": "module",
  "bin": {
    "ksp-upload": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx --conditions=ksp-src src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ksp/shared": "*"
  }
}
