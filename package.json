{
  "name": "ksp-vms",
  "private": true,
  "description": "KSP Video Evidence Management & AI Analysis Platform",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "services": "scripts/dev/services.sh start",
    "db:migrate": "npm run -w @ksp/core migrate",
    "db:seed": "npm run -w @ksp/core seed",
    "db:codegen": "npm run -w @ksp/core codegen",
    "dev:api": "npm run -w @ksp/api dev",
    "dev:worker": "npm run -w @ksp/worker dev",
    "dev:ai": "npm run -w @ksp/ai-worker dev",
    "dev:web": "npm run -w @ksp/web dev",
    "build": "npm run build -w @ksp/shared && npm run build -w @ksp/core && npm run build -w @ksp/api -w @ksp/worker -w @ksp/ai-worker -w @ksp/web -w @ksp/station-client",
    "typecheck": "npm run build -w @ksp/shared -w @ksp/core && npm run typecheck --workspaces --if-present",
    "lint": "eslint --concurrency=4 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:stack": "tests/e2e/scripts/stack.sh",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "otplib": "^12.0.1",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
